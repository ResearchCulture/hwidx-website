---
permalink: "/catalog/index.html"
title: Device catalog
---
{#- Shell for the device catalog. nginx serves this for /catalog/ and /catalog/<page>/,
    and catalog.js fills it from the router's live dataset API. -#}
{%- extends "wide.njk" -%}

{%- block content -%}
<div class="page-header">
<div>
<h1 class="page-title">Device catalog</h1>
<p class="muted" data-catalog-count>&nbsp;</p>
</div>
<a class="button secondary" href="/search/">Search the index</a>
</div>

<div class="table-wrap">
<table class="data-table">
<thead>
<tr>
<th scope="col">Name</th>
<th scope="col">Identifier</th>
<th scope="col">Organisation</th>
<th scope="col">Group</th>
</tr>
</thead>
<tbody data-catalog-rows>
<tr><td colspan="4"><p class="loading" role="status">Loading…</p></td></tr>
</tbody>
</table>
</div>

<noscript>
<p>The catalog is loaded from the live index and needs JavaScript enabled.</p>
</noscript>

<nav class="pagination" aria-label="Catalog pages" data-catalog-pagination></nav>
{%- endblock content -%}

{%- block scripts -%}
<script type="module" src="/assets/js/catalog.js?v={{ build.version }}"></script>
{%- endblock scripts -%}
