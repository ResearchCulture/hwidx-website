---
pagination:
  data: hwidx
  size: 1
permalink: "/{{ pagination.items[0] }}/"
---
{%- set entity = hwidx[pagination.items[0]] -%}
{%- extends "base.njk" -%}

{%- block content -%}

<div class="mb-10">
  <h1><strong>hwidx.org/{{ pagination.items[0] }}</strong></h1>
</div>

<div>
{%- for key, value in entity -%}
  {%- if key.startsWith('_') -%}
    {# Skip internal keys #}
  {%- else -%}

    <h3>{{ key | capitalize }}:</h3>
    {%- if value is string -%}
      {%- if value.startsWith("http") -%}
        <p style="margin-left: 3rem;"><a href="{{ value }}">{{ value }}</a></p>
      {%- else -%}
        <p style="margin-left: 3rem;">{{ value }}</p>
      {%- endif -%}
    {%- elif value is iterable -%}
      <div style="margin-left: 3rem;">
        {%- for line in value -%}
          <p>{{ line }}</p>
        {%- endfor -%}
      </div>
    
    {%- else -%}
      <div style="margin-left: 3rem;">
        {%- for subkey, item in value -%}
          <h4>{{ subkey | capitalize }}:</h4>
          {%- if item.startsWith("http") -%}
            <p style="margin-left: 3rem;"><a href="{{ item }}">{{ item }}</a></p>
          {%- else -%}
            <p style="margin-left: 3rem;">{{ item }}</p>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

  {%- endif -%}
{% endfor %}
</div>

<br /><br /><br />

<div>
  <h3>Bare QR Code:</h3>
  <img src="qr.png" alt="The hwidx.org URL as a QR code" style="width: 200px;" />
</div>
<div>
  <h3>LogoMark:</h3>
  <img src="logo-mark.png" alt="The hwidx.org URL as a QR code with logo mark" style="width: 200px;" />
</div>
<div>
  <h3>LogoMark (Horizontal):</h3>
  <div class="flex">
    <img src="logo-mark-horizontal.png" alt="The hwidx.org URL as a QR code with logo mark (horizontal)" style="width: 200px;" />
    <img src="logo-mark-horizontal-invert.png" alt="The hwidx.org URL as a QR code with logo mark (horizontal, inverted)" style="width: 200px;" />
  </div>
</div>
<div>
  <h3>LabelMark:</h3>
  <img src="label-mark.png" alt="The hwidx.org URL as a QR code with label mark" style="width: 200px;" />
</div>

<div class="yaml-record">
  <h3>YAML Record</h3>
  <tt><pre>{{ entity | toYAML }}</pre></tt>
</div>

{% endblock content %}