---
pagination:
  data: hwidx
  size: 1
permalink: "/{{ pagination.items[0] }}/"
---
{%- set entity = hwidx[pagination.items[0]] -%}
{%- extends "base.njk" -%}

{%- block content -%}

<div class="mb-10">
  <h1><strong>hwidx.org/{{ pagination.items[0] }}</strong></h1>
</div>

<div>
{%- for key, value in entity -%}
  {%- if key.startsWith('_') -%}
    {# Skip internal keys #}
  {%- else -%}

    <h3>{{ key | capitalize }}:</h3>
    {%- if value is number -%}
      <p style="margin-left: 3rem;">{{ value }}</p>
    {%- elif value is string -%}
      {%- if value.startsWith("http") -%}
        <p style="margin-left: 3rem;"><a href="{{ value }}">{{ value }}</a></p>
      {%- else -%}
        <p style="margin-left: 3rem;">{{ value }}</p>
      {%- endif -%}
    {%- elif value is iterable -%}
      <div style="margin-left: 3rem;">
        {%- for line in value -%}
          <p>{{ line }}</p>
        {%- endfor -%}
      </div>
    
    {%- else -%}
      <div style="margin-left: 3rem;">
        {%- for subkey, item in value -%}
          <h4>{{ subkey | capitalize }}:</h4>
          {%- if item.startsWith("http") -%}
            <p style="margin-left: 3rem;"><a href="{{ item }}">{{ item }}</a></p>
          {%- else -%}
            <p style="margin-left: 3rem;">{{ item }}</p>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

  {%- endif -%}
{% endfor %}
</div>

<br />

<div>
  <h3>QR Code:</h3>
  <p style="margin-left: 3rem;"><a href="/make-a-qr-code/?type=bare-qr&o={{ pagination.items[0].split('/')[0] }}&d={{ pagination.items[0].split('/')[1] }}&v={{ pagination.items[0].split('/')[2] }}">QR Code Generator</a></p>
</div>

<p class="mt-8"><a href="../">⬅ Back to version list</a></p>

<div class="yaml-record">
  <h3>YAML Record</h3>
  <tt><pre>{{ entity | toYAML }}</pre></tt>
</div>

{% endblock content %}