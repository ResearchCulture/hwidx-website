---
pagination:
  data: hwidxIndex.deviceList
  size: 1
  alias: dir
permalink: "/{{ dir.path }}/index.html"
eleventyExcludeFromCollections: true
---
{%- extends "base.njk" -%}

{%- block content -%}
<div class="mb-10">
  <h1><strong>hwidx.org/{{ dir.path }}</strong></h1>
  {%- if dir.data.org -%}
    <p class="text-md">
        {%- if dir.data.org.url -%}
          <a href="{{ dir.data.org.url }}">{{ dir.data.org.name }}</a>
        {%- else -%}
          {{ dir.data.org.name }}
        {%- endif -%}
        {%- if dir.data.group %}
        &nbsp;•&nbsp;{%- if dir.data.group.url -%}
          <a href="{{ dir.data.group.url }}">{{ dir.data.group.name }}</a>
        {%- else -%}
           • {{ dir.data.group.name }}
        {%- endif -%}
        {%- endif -%}
    </p>
  {%- endif -%}
</div>

{%- if dir.children and dir.children.length -%}
  <div class="mb-8">
    <h3>Versions</h3>
    <ul class="ml-8 list-disc">
      {%- for child in dir.children -%}
        <li>
          <a href="{{ child.url }}">
            {%- if child.title -%}
              {{ child.title }} (v{{ child.slug }})
            {%- else -%}
              Version {{ child.slug }}
            {%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
{%- else -%}
  <p>No versions found.</p>
{%- endif -%}

{%- if dir.parentPath -%}
  <p class="mt-8"><a href="{{ dir.parentUrl }}">⬅ Back to {{ dir.data.org.name if dir.data.org else 'organization' }}</a></p>
{%- endif -%}

<div class="yaml-record mt-8">
  <h3>YAML Record</h3>
  <tt><pre>{{ dir.data | toYAML }}</pre></tt>
</div>

{%- endblock content -%}
