{% extends 'base.njk' %}

{% block content %}
<section class="max-w-4xl mx-auto py-10 px-6">
  <h2 class="text-3xl font-bold mb-4">Live QR Code Generator</h2>
  <p>Enter your device details to generate a QR code.</p>
  <p class="mb-6">Note that this will not automatically grant the use of this identifier. To obtain an identifier please open a pull request on <a href="https://github.com/ResearchCulture/hwidx" target="_blank">the HWIDX Github Index Repository</a>.</p>

  <form data-qr-generator class="flex-col gap-4">
    <div class="grid grid-cols-3 gap-4 items-center my-4">
        <div class="flex flex-col gap-2">
            <label for="qr-input-org" class="font-semibold">Organisation</label>
            <input
                id="qr-input-org"
                data-qr-org
                type="number"
                placeholder="organisation"
                class="border border-gray-400 rounded px-4 py-3 bg-white"
                required
            >
        </div>
        <div class="flex flex-col gap-2">
            <label for="qr-input-device" class="font-semibold">Device</label>
            <input
                id="qr-input-device"
                data-qr-device
                type="text"
                placeholder="device"
                class="border border-gray-400 rounded px-4 py-3 bg-white"
                required
            >
        </div>
        <div class="flex flex-col gap-2">
            <label for="qr-input-version" class="font-semibold">Version</label>
            <input
                id="qr-input-version"
                data-qr-version
                type="text"
                placeholder="version"
                class="border border-gray-400 rounded px-4 py-3 bg-white"
                required
            >
        </div>
    </div>

    <div>
        <span data-qr-status class="text-sm text-gray-700">Enter your information above to generate a QR code.</span>
    </div>

    <div>
        <label for="qr-output-url" class="font-semibold">Test URL (opens in a new tab)</label>
        <a href="https://hwidx.org/" target="_blank" rel="noopener noreferrer" data-qr-output-url>...</a>
    </div>

    <div>
        <label for="qr-output-style" class="font-semibold">Output Style</label>
        <select id="qr-output-style" data-qr-output-style class="border border-gray-400 rounded px-4 py-3 bg-white w-full">
            <option value="bare-qr" selected>Bare QR Code</option>
            <option value="logo-mark-horizontal">Logo Mark Horizontal</option>
            <option value="logo-mark-horizontal-inverted">Logo Mark Horizontal (inverted colour)</option>
            <option value="logo-mark-vertical">Logo Mark Vertical</option>
            <option value="label-mark">Label Mark</option>
        </select>
    </div>

    <div class="flex flex-col items-center gap-2 width-full bg-striped p-4">
        <h3>Preview</h3>
        <canvas
        data-qr-canvas
        width="600"
        height="600"
                class="block w-[300px] max-w-full h-auto"
        ></canvas>
        <a data-qr-download class="button bg-white border border-gray-500" href="#">Download as a PNG</a>
    </div>
    
  </form>
</section>
{% endblock content %}

{% block scripts %}
<script type="module" src="/assets/js/mark-types.js"></script>
<script type="module" src="/assets/js/mark-generator.js"></script>
{% endblock scripts %}