{#- Search box posting to the /search/ results page. Options: large (hero size), value, autofocus, name (input id) -#}
{%- macro searchBox(options = {}) -%}
<form class="search-box{% if options.large %} search-box--large{% endif %}" action="/search/" method="get" role="search">
<svg class="search-box__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
<input type="search" name="q" value="{{ options.value }}" placeholder="Search devices, organisations or identifiers" aria-label="Search the index" required maxlength="200"{% if options.autofocus %} autofocus{% endif %}>
<button type="submit">Search</button>
</form>
{%- endmacro -%}
