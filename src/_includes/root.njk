{%- from "components/hwidx-search.njk" import searchBox -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{% if title %}{{ title }} · {% endif %}hwidx.org – The Hardware Index</title>
{%- set pageTitle %}{% if title %}{{ title }} · {% endif %}hwidx.org – The Hardware Index{% endset -%}
{%- set pageDescription = description or site.description -%}
<meta name="description" content="{{ pageDescription }}">
{#- Pages whose address is only known in the browser (the metapage shell, the catalog) set dynamicUrl, and their script adds the canonical and og:url -#}
{%- if not dynamicUrl %}
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
{%- endif %}
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:image" content="{{ site.url }}{{ site.image }}">
<meta property="og:image:alt" content="{{ site.imageAlt }}">
<meta name="twitter:card" content="summary_large_image">
<link rel="stylesheet" href="/assets/css/main.css?v={{ build.version }}">
</head>
<body>
<header class="site-header">
<div class="site-header__inner">
<a class="brand" href="/"><span class="brand__mark">hwidx.org</span><span class="brand__tag">The Hardware Index</span></a>
<nav class="site-nav" aria-label="Main">
<a href="/catalog/"{% if page.url and page.url.startsWith("/catalog") %} aria-current="page"{% endif %}>Catalog</a>
<a href="/search/"{% if page.url and page.url.startsWith("/search") %} aria-current="page"{% endif %}>Search</a>
<a href="/make-a-qr-code/"{% if page.url and page.url.startsWith("/make-a-qr-code") %} aria-current="page"{% endif %}>Make a QR code</a>
<span class="site-nav__sep" aria-hidden="true">|</span>
<a href="/router/"{% if page.url and page.url.startsWith("/router") %} aria-current="page"{% endif %}>Router Info</a>
</nav>
{%- if not hideHeaderSearch %}
{{ searchBox() }}
{%- endif %}
</div>
</header>
{% block hero %}{% endblock hero %}
{% block wrapper %}
Missing wrapper content...
{% endblock wrapper %}
<footer class="site-footer">
<div class="site-footer__inner">
<div>
<div class="brand__mark">hwidx.org</div>
<div>&copy; 2024 Hardware Index. All rights reserved.</div>
<ul class="site-footer__links">
<li>Contact via <a href="https://github.com/ResearchCulture/hwidx/issues" target="_blank" rel="noopener">GitHub Issues</a></li>
<li><a href="/link-checker/">Link checker</a></li>
<li>Analytics by <a href="https://simpleanalytics.com/" target="_blank" rel="noopener">Simple Analytics</a></li>
</ul>
</div></div>
</footer>
{% block scripts %}
{% endblock scripts %}
<!-- 100% privacy-first analytics -->
<script async src="https://scripts.simpleanalyticscdn.com/latest.js"></script>
</body>
</html>
